---
/**
 * Header — sticky top bar styled as a TUI tab strip.
 * Navigation uses native anchor links; smooth scrolling and the sticky
 * offset are handled in CSS (`scroll-behavior` + `scroll-padding-top`).
 *
 * Section ids are stable across locales (Spanish slugs), so switching
 * language keeps the reader at the same section (see script below).
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocale, localeMeta, locales, useTranslations } from "../i18n";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const links = [
  { href: "#experiencia", label: t.nav.experience },
  { href: "#proyectos", label: t.nav.projects },
  { href: "#logros", label: t.nav.achievements },
  { href: "#habilidades", label: t.nav.skills },
  { href: "#contacto", label: t.nav.contact },
];

const languages = locales.map((l) => ({
  locale: l,
  href: getRelativeLocaleUrl(l),
  ...localeMeta[l],
}));
---

<header
  id="header"
  class="sticky top-0 z-50 grid grid-cols-[1fr_auto] lg:flex items-center lg:justify-between gap-x-4 gap-y-2 py-2.5 lg:py-0 lg:h-14 px-4 sm:px-8 w-full border-b border-charm-border bg-charm-bg/95 font-mono"
>
  <!-- < lg: brand + language + CV on row 1, nav as a scrollable tab strip on row 2. -->
  <div class="contents lg:flex items-center gap-8 min-w-0">
    <a href="#inicio" class="brand-link shrink-0 text-sm font-semibold text-charm-text no-underline select-none">
      whoAngeel<span class="brand-cursor" aria-hidden="true">_</span>
    </a>
    <nav aria-label={t.nav.label} class="nav-scroll col-span-2 row-start-2 min-w-0 overflow-x-auto">
      <ul class="flex items-center gap-x-5 sm:gap-x-7 text-xs sm:text-sm py-1 lg:py-0">
        {links.map((l) => (
          <li class="shrink-0">
            <a href={l.href} class="nav-link text-charm-muted">{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="col-start-2 row-start-1 flex items-center gap-3 sm:gap-4 shrink-0">
    <!-- Language switch: `ES | EN`, current locale highlighted. -->
    <ul class="lang-switch flex flex-nowrap items-center whitespace-nowrap text-xs" aria-label={t.nav.language}>
      {languages.map((l) => (
        <li>
          <a
            href={l.href}
            hreflang={l.bcp47}
            lang={l.locale}
            title={l.name}
            class:list={["lang-link", { "is-current": l.locale === locale }]}
            aria-current={l.locale === locale ? "true" : undefined}
            data-lang-link
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <!-- TODO: point to the real CV file once it exists (e.g. public/cv.pdf). -->
    <button type="button" class="tui-btn tui-btn--primary shrink-0 !py-1 !px-3 text-xs sm:text-sm" aria-label={t.nav.downloadCv}>
      <span class="sm:hidden" aria-hidden="true">CV</span>
      <span class="hidden sm:inline" aria-hidden="true">{t.nav.downloadCv}</span>
    </button>
  </div>
</header>

<style>
  .nav-scroll {
    scrollbar-width: none;
    /* Fade the right edge so overflow reads as "scrollable" on phones. */
    mask-image: linear-gradient(to right, #000 85%, transparent);
  }
  .nav-scroll::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 1180px) {
    .nav-scroll {
      mask-image: none;
    }
  }

  .nav-link {
    text-decoration: none;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--charm-text);
  }

  .lang-link {
    display: inline-block;
    padding: 0.15rem 0.4rem;
    color: var(--charm-muted);
    text-decoration: none;
    border-radius: 2px;
  }
  .lang-switch li {
    display: flex;
    align-items: center;
  }
  .lang-switch li + li::before {
    content: "|";
    color: var(--charm-border-soft);
  }
  .lang-link:hover {
    color: var(--charm-text);
  }
  .lang-link.is-current {
    color: var(--charm-bg);
    background: var(--charm-accent-soft);
    font-weight: 600;
  }

  .brand-link:hover {
    color: var(--charm-accent-text);
  }

  .brand-cursor {
    margin-left: 1px;
    color: var(--charm-accent-soft);
    animation: tui-blink 1.06s step-end infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-cursor {
      animation: none;
    }
  }
</style>

<script>
  /** Keep the current section when switching language (ids are shared). */
  document.querySelectorAll<HTMLAnchorElement>("[data-lang-link]").forEach((link) => {
    link.addEventListener("click", () => {
      const active = document.querySelector<HTMLAnchorElement>(".nav-link.active");
      const hash = location.hash || active?.hash;
      if (hash) link.hash = hash;
    });
  });

  /** Highlight the nav link of the section currently in view. */
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav-link"));
  const byId = new Map(links.map((l) => [l.hash.slice(1), l]));

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((l) => {
          const active = l === byId.get(entry.target.id);
          l.classList.toggle("active", active);
          if (active) l.setAttribute("aria-current", "true");
          else l.removeAttribute("aria-current");
        });
      }
    },
    // A thin band ~30% from the top acts as the "current section" line.
    { rootMargin: "-30% 0px -69% 0px" },
  );

  byId.forEach((_, id) => {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  });

  const header = document.getElementById("header");
  if (header) {
    const onScroll = () => {
      header.style.borderBottomColor = window.scrollY > 0 ? "var(--charm-border-soft)" : "";
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
