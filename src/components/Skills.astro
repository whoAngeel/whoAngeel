---
/**
 * Skills — one Lipgloss frame per category; tags stagger in on scroll.
 */
import Frame from "./Frame.astro";
import SectionHeader from "./SectionHeader.astro";
import { getLocale, shell, useTranslations } from "../i18n";

const t = useTranslations(getLocale(Astro.currentLocale));

const categories = [
  {
    name: t.skills.backend,
    items: ["Python", "Go", "Node.js", "NestJS", "FastAPI", "Express.js", "PostgreSQL", "MongoDB", "Redis"]
  },
  {
    name: t.skills.cloud,
    items: ["GCP", "Cloud Functions", "PubSub", "Firestore", "Vertex AI", "Docker", "DigitalOcean", "Cloud Run", "AWS Lambda", "GitHub Actions", "Cloud Storage"]
  },
  {
    name: t.skills.frontend,
    items: ["Astro", "React", "Next.js", "TypeScript", "Tailwind", "Flutter", "Vue.js"]
  },
  {
    name: t.skills.ai,
    items: ["LLM Multimodal", "YOLO", "n8n", "Qdrant", "LangChain"]
  },
  {
    name: t.skills.tools,
    items: ["Git", "Linux", "Charm CLI", "Go TUI", "gcloud CLI"]
  }
];
---

<section id="habilidades" class="section">
  <SectionHeader title={t.sections.skills.title} path={shell.paths.skills} />

  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-8">
    {
      categories.map((cat, i) => (
        <Frame
          as="div"
          class:list={["skill-cat px-5 pt-6 pb-5", { "md:col-span-2": i === categories.length - 1 }]}
        >
          <Fragment slot="title">
            <span class="text-charm-accent-text tabular-nums">0{i + 1}</span> ─ <strong>{cat.name}</strong>
          </Fragment>
          <h3 class="sr-only">{cat.name}</h3>
          <ul class="flex flex-wrap gap-2">
            {cat.items.map((item) => (
              <li class="skill-tag">{item}</li>
            ))}
          </ul>
        </Frame>
      ))
    }
  </div>
</section>

<style>
  .skill-tag {
    padding: 0.25rem 0.625rem;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--charm-muted);
    background: var(--charm-surface-strong);
    border: 1px solid var(--charm-border);
    border-radius: 2px;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out), background 0.2s var(--ease-out);
  }
  .skill-tag:hover {
    color: var(--charm-text);
    background: rgba(124, 58, 237, 0.14);
    border-color: rgba(157, 121, 243, 0.6);
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.utils.toArray<HTMLElement>(".skill-cat").forEach((cat) => {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: cat,
          start: "top 85%",
          toggleActions: "play none none reverse"
        }
      });

      tl.from(cat, {
        y: 30,
        opacity: 0,
        duration: 0.5,
        ease: "power3.out"
      });

      tl.from(cat.querySelectorAll(".skill-tag"), {
        y: 12,
        opacity: 0,
        duration: 0.35,
        stagger: 0.06,
        ease: "power2.out"
      }, "-=0.2");
    });
  }
</script>
