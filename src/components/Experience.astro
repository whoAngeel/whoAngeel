---
/**
 * Experience — vertical timeline. Each role is an `.exp-item`; each project
 * inside a role is an `.exp-project` rendered like a tree node (├─).
 * Content: src/data/experience.ts.
 */
import Tag from "./Tag.astro";
import SectionHeader from "./SectionHeader.astro";
import { experience } from "../data/experience";
import { getLocale, localize, shell, useTranslations } from "../i18n";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section id="experiencia" class="section">
  <SectionHeader title={t.sections.experience.title} path={shell.paths.experience} />

  <div class="max-w-3xl">
    <div class="exp-timeline border-l border-charm-border-soft pl-6 sm:pl-8 space-y-12">
      {experience.map((role) => (
        <article class="exp-item" aria-labelledby={`exp-${role.id}`}>
          <p class="font-mono text-xs sm:text-sm text-charm-accent-text tracking-wide">{localize(role.period, locale)}</p>
          <h3 id={`exp-${role.id}`} class="font-mono text-xl sm:text-2xl font-semibold text-charm-text mt-1">
            {localize(role.title, locale)}
          </h3>
          <p class="font-mono text-charm-muted-soft text-xs sm:text-sm mt-1">{localize(role.org, locale)}</p>

          <div class="text-charm-muted mt-6 leading-relaxed space-y-6">
            {role.projects.map((project) => (
              <div class="exp-project">
                <p>
                  <strong class="exp-project-title">{localize(project.title, locale)}</strong>
                  {localize(project.detail, locale)}
                </p>
                <ul class="flex flex-wrap gap-1.5 mt-3" aria-label={t.a11y.stack}>
                  {project.stack.map((label) => <Tag label={label} />)}
                </ul>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .exp-item {
    position: relative;
  }

  /* Timeline node: a square "cell" instead of a round dot, TUI style. */
  .exp-item::before {
    content: '';
    position: absolute;
    top: 0.3em;
    left: calc(-1.5rem - 5px);
    width: 9px;
    height: 9px;
    background: var(--charm-accent-soft);
    outline: 3px solid var(--charm-bg);
  }
  @media (min-width: 640px) {
    .exp-item::before {
      left: calc(-2rem - 5px);
    }
  }

  .exp-project {
    position: relative;
    padding-left: 1.5rem;
  }
  .exp-project::before {
    content: '├─';
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    color: var(--charm-border-soft);
  }
  .exp-project:last-child::before {
    content: '└─';
  }

  .exp-project-title {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--charm-text);
  }
</style>
