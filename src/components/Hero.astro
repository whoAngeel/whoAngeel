---
/**
 * Hero — rendered as a terminal session:
 *   ❯ whoami          → animated ASCII word (src/scripts/ascii-text.ts)
 *   ❯ cat whoami.txt  → name + role (h1)   (commands: `shell` in src/i18n,
 *   ❯ cat about-me.md → short bio            English in every locale)
 *   ❯ █               → idle prompt with block cursor
 * plus a Bubble Tea–style status bar.
 *
 * The figlet <pre> is the no-JS / no-WebGL fallback and is swapped out
 * once the WebGL animation initialises.
 */
import Frame from "./Frame.astro";
import { getLocale, localeMeta, shell, useTranslations } from "../i18n";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const figlet = String.raw`          _                           _
__      _| |__   ___   __ _ _ __ ___ (_)
\ \ /\ / / '_ \ / _ \ / _${"`"} | '_ ${"`"} _ \| |
 \ V  V /| | | | (_) | (_| | | | | | | |
  \_/\_/ |_| |_|\___/ \__,_|_| |_| |_|_|`;
---

<section id="inicio" class="hero-section relative flex items-center justify-center px-4 sm:px-8 pt-8 pb-16 sm:pt-12">
  <Frame as="div" class="hero-term w-full max-w-5xl">
    <Fragment slot="title"><strong>angel@whoangeel</strong>:~/portfolio</Fragment>

    <div class="px-4 sm:px-8 pt-7 pb-6 sm:pt-9 font-mono text-sm">
      <!-- 1. whoami → ASCII art -->
      <p class="hero-line"><span class="tui-prompt">❯</span> whoami</p>
      <div class="ascii-stage" data-ascii-text="whoami">
        <span class="sr-only">whoami</span>
        <pre class="ascii-fallback" aria-hidden="true">{figlet}</pre>
      </div>

      <!-- 2. Quién soy -->
      <p class="hero-line mt-2"><span class="tui-prompt">❯</span> {shell.who}</p>
      <h1 class="hero-name mt-3 text-[1.75rem] leading-tight sm:text-4xl md:text-5xl font-bold text-charm-text tracking-tight">
        Angel Jesus Zorrilla Cuevas
      </h1>
      <p class="hero-role mt-2 text-charm-muted text-base sm:text-lg">
        {t.hero.role} <span class="text-charm-muted-soft">·</span>
        <span class="text-charm-accent-text">whoAngeel</span>
      </p>

      <!-- 3. Sobre mí -->
      <p class="hero-line mt-8"><span class="tui-prompt">❯</span> {shell.bio}</p>
      <p class="hero-desc mt-3 font-sans text-base text-charm-muted leading-relaxed" set:html={t.hero.bio} />

      <div class="hero-actions mt-8 flex flex-wrap gap-3">
        <a href="#proyectos" class="tui-btn tui-btn--primary">{t.hero.ctaProjects}</a>
        <a href="#logros" class="tui-btn">{t.hero.ctaAchievements}</a>
        <a href="#contacto" class="tui-btn">{t.hero.ctaContact}</a>
      </div>

      <p class="hero-line mt-8" aria-hidden="true">
        <span class="tui-prompt">❯</span> <span class="tui-cursor"></span>
      </p>
    </div>

    <!-- Status bar -->
    <div class="hero-status flex items-stretch border-t border-charm-border-soft font-mono text-xs">
      <span class="status-mode">NORMAL</span>
      <span class="status-seg status-seg--wide">~/portfolio</span>
      <span class="flex-1"></span>
      <span class="status-seg">
        <span class="status-dot" aria-hidden="true"></span>{t.hero.available}
      </span>
      <span class="status-seg status-seg--wide">{localeMeta[locale].bcp47}</span>
    </div>
  </Frame>
</section>

<style>
  .hero-section {
    /* Fill the first screen below the sticky header (≈ 3.5rem). */
    min-height: calc(100svh - 3.5rem);
  }

  .hero-term {
    background: rgba(17, 18, 20, 0.92);
  }

  .hero-line {
    color: var(--charm-muted);
  }

  .hero-name {
    font-family: var(--font-mono);
  }

  .ascii-stage {
    position: relative;
    height: clamp(9rem, 26vw, 17rem);
    margin-inline: -0.5rem;
    overflow: hidden;
    color: var(--charm-accent-soft);
  }

  /* Generated by AsciiText; `:global` because it is created at runtime. */
  .ascii-stage :global(.ascii-text-pre) {
    position: absolute;
    inset: 0;
    margin: 0;
    line-height: 1em;
    white-space: pre;
    user-select: none;
    pointer-events: none;
  }

  .ascii-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    margin: 0;
    font-size: clamp(0.5rem, 1.6vw, 1rem);
    line-height: 1.15;
  }

  .ascii-stage.is-live .ascii-fallback {
    display: none;
  }

  .status-mode,
  .status-seg {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    white-space: nowrap;
  }

  .status-mode {
    font-weight: 700;
    color: var(--charm-bg);
    background: var(--charm-accent-soft);
    border-bottom-left-radius: 5px;
  }

  .status-seg {
    color: var(--charm-muted);
    border-left: 1px solid var(--charm-border);
  }

  /* Secondary segments only fit from `sm` up. (A scoped `display` would
     override Tailwind's `hidden`, so the breakpoint lives here.) */
  @media (max-width: 639px) {
    .status-seg--wide {
      display: none;
    }
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--charm-success);
  }
</style>

<script>
  /**
   * Lazy-load three.js + the ASCII renderer so they don't block first paint.
   * Any failure (no WebGL, old browser) leaves the static figlet in place.
   */
  const stage = document.querySelector<HTMLElement>("[data-ascii-text]");

  if (stage) {
    const boot = async () => {
      try {
        const { AsciiText } = await import("../scripts/ascii-text");
        const narrow = window.matchMedia("(max-width: 639px)").matches;
        const ascii = new AsciiText(stage, {
          text: stage.dataset.asciiText ?? "whoami",
          asciiFontSize: narrow ? 6 : 9,
          planeBaseHeight: 12,
        });
        await ascii.init();
        stage.classList.add("is-live");
      } catch (err) {
        console.warn("[ascii-text] falling back to static art:", err);
      }
    };

    if ("requestIdleCallback" in window) requestIdleCallback(boot, { timeout: 1500 });
    else setTimeout(boot, 200);
  }
</script>
