---
/**
 * Projects — two views behind a TUI tab switch:
 *
 *   [ swap ]  (default) detail panel + animated 3D card stack
 *             (src/scripts/card-swap.ts, port of React Bits CardSwap)
 *   [ grid ]  every project as a Lipgloss frame card
 *
 * The chosen view is stored in localStorage and applied before first paint
 * by the inline script in Layout.astro (`html[data-projects-view]`), so
 * there is no flash. Without JS only the grid is shown.
 *
 * Data: src/data/projects.ts.
 */
import Frame from "./Frame.astro";
import SectionHeader from "./SectionHeader.astro";
import ProjectBody from "./ProjectBody.astro";
import { projects } from "../data/projects";
import { getLocale, localize, shell, useTranslations } from "../i18n";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const nameOf = (p: (typeof projects)[number]) => localize(p.name, locale);

// BASE_URL has no trailing slash in this config ("/whoAngeel").
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pad = (n: number) => String(n).padStart(2, "0");
const total = pad(projects.length);
---

<section id="proyectos" class="section">
  <SectionHeader
    title={t.sections.projects.title}
    path={shell.paths.projects}
    meta={t.sections.items(total)}
    lead={t.sections.projects.lead}
  />

  <!-- Toolbar: view switch (left) + swap controls (right) -->
  <div class="view-toolbar mb-8 flex flex-wrap items-center justify-between gap-3 font-mono text-xs sm:text-sm">
    <div class="flex items-center gap-2">
      <span class="text-charm-muted-soft" aria-hidden="true">{t.projects.view}</span>
      <div role="tablist" aria-label={t.projects.viewsLabel} class="view-tabs">
        <button type="button" role="tab" id="tab-swap" aria-controls="projects-swap" data-view-tab="swap" class="view-tab">swap</button>
        <button type="button" role="tab" id="tab-grid" aria-controls="projects-grid" data-view-tab="grid" class="view-tab">grid</button>
      </div>
    </div>

    <div class="swap-controls flex items-center">
      <button type="button" class="swap-btn" data-swap="prev" aria-label={t.projects.prev}>‹</button>
      <button type="button" class="swap-btn swap-btn--wide" data-swap="toggle" aria-pressed="false"
        aria-label={t.projects.pause} data-label-pause={t.projects.pause} data-label-resume={t.projects.resume}>
        <span data-swap-icon aria-hidden="true">||</span>
      </button>
      <button type="button" class="swap-btn" data-swap="next" aria-label={t.projects.next}>›</button>
      <span class="swap-count" aria-hidden="true"><span data-swap-current>01</span>/{total}</span>
    </div>
  </div>

  <!-- ─────────────────────────── Swap view ─────────────────────────── -->
  <div id="projects-swap" role="tabpanel" aria-labelledby="tab-swap" class="swap-view" data-swap-root>
    <div class="swap-layout">
      <!-- Detail of the card in front. Only the active panel is visible. -->
      <!-- aria-live is "off" during autoplay and "polite" for manual navigation. -->
      <div class="swap-panels" aria-live="off">
        {projects.map((p, i) => (
          <Frame
            as="article"
            class="swap-panel h-full flex flex-col"
            data-swap-panel={i}
            data-project-id={p.id}
            hidden={i !== 0}
            aria-labelledby={`swap-${p.id}-title`}
          >
            <Fragment slot="title">
              <span class="text-charm-accent-text">{pad(i + 1)}</span> ─ {p.id}
            </Fragment>
            <ProjectBody project={p} headingId={`swap-${p.id}-title`} class="flex-1 px-5 pt-6 pb-5" />
          </Frame>
        ))}
      </div>

      <!-- Visual stack. Decorative duplicate of the panels → aria-hidden;
           keyboard users drive it with the toolbar buttons. -->
      <div class="swap-stage" data-swap-stage aria-hidden="true">
        {projects.map((p, i) => (
          <div class="swap-card" data-swap-card={i} title={nameOf(p)}>
            <div class="swap-card-bar">
              <span class="text-charm-accent-text">{pad(i + 1)}</span>
              <span class="truncate">{nameOf(p)}</span>
              {p.award && <span class="ml-auto text-charm-accent-text">★</span>}
            </div>
            <div class="swap-card-media">
              {p.images?.length ? (
                <img
                  src={base + p.images[0]}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class:list={{ "is-contain": p.imageFit === "contain" }}
                />
              ) : (
                <div class="project-placeholder">
                  <span class="text-charm-muted-soft">$ tree ./{p.id}</span>
                  <span class="project-placeholder-name">{nameOf(p)}</span>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ─────────────────────────── Grid view ─────────────────────────── -->
  <div id="projects-grid" role="tabpanel" aria-labelledby="tab-grid" class="grid-view grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-10">
    {projects.map((p, i) => (
      <Frame
        as="article"
        id={`proyecto-${p.id}`}
        class:list={["project-card flex flex-col", { "project-card--featured md:col-span-2": p.featured }]}
        aria-labelledby={`proyecto-${p.id}-title`}
      >
        <Fragment slot="title">
          <span class="text-charm-accent-text">{pad(i + 1)}</span> ─ {p.id}
        </Fragment>

        <div class="project-media">
          {p.images?.length ? (
            <div class="carousel" data-carousel>
              {p.images.map((img, j) => (
                <img
                  src={base + img}
                  alt={t.projects.screenshotAlt(nameOf(p), j + 1, p.images!.length)}
                  loading="lazy"
                  decoding="async"
                  class:list={["carousel-img", { "is-active": j === 0, "is-contain": p.imageFit === "contain" }]}
                  data-slide={j}
                  aria-hidden={j === 0 ? undefined : "true"}
                />
              ))}
              {p.images.length > 1 && (
                <div class="carousel-controls">
                  <button type="button" class="carousel-btn" data-dir="-1" aria-label={t.projects.prevShot(nameOf(p))}>‹</button>
                  <span class="carousel-count" aria-live="polite">
                    <span data-current>1</span>/{p.images.length}
                  </span>
                  <button type="button" class="carousel-btn" data-dir="1" aria-label={t.projects.nextShot(nameOf(p))}>›</button>
                </div>
              )}
            </div>
          ) : (
            <div class="project-placeholder" aria-hidden="true">
              <span class="text-charm-muted-soft">$ tree ./{p.id}</span>
              <span class="project-placeholder-name">{nameOf(p)}</span>
              <span class="text-charm-muted-soft">{t.projects.noScreenshots}</span>
            </div>
          )}
        </div>

        <ProjectBody project={p} headingId={`proyecto-${p.id}-title`} class="flex-1 px-5 pt-4 pb-5" />
      </Frame>
    ))}
  </div>
</section>

<style>
  /* ── View switching (state lives on <html>, see Layout.astro) ─────── */
  :global(html:not(.js)) .view-toolbar,
  :global(html:not(.js)) .swap-view,
  :global(html.js:not([data-projects-view="grid"])) .grid-view,
  :global(html.js[data-projects-view="grid"]) .swap-view,
  :global(html.js[data-projects-view="grid"]) .swap-controls {
    display: none;
  }

  /* ── Toolbar ──────────────────────────────────────────────────────── */
  .view-tabs {
    display: inline-flex;
    border: 1px solid var(--charm-border-soft);
    border-radius: 2px;
  }

  .view-tab {
    padding: 0.25rem 0.75rem;
    color: var(--charm-muted);
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: color 0.2s var(--ease-out), background 0.2s var(--ease-out);
  }
  .view-tab + .view-tab {
    border-left: 1px solid var(--charm-border-soft);
  }
  .view-tab::before { content: "[ "; color: var(--charm-muted-soft); }
  .view-tab::after { content: " ]"; color: var(--charm-muted-soft); }
  .view-tab:hover {
    color: var(--charm-text);
  }
  .view-tab[aria-selected="true"] {
    color: var(--charm-bg);
    background: var(--charm-accent-soft);
    font-weight: 600;
  }
  .view-tab[aria-selected="true"]::before,
  .view-tab[aria-selected="true"]::after {
    color: inherit;
  }

  .swap-controls {
    border: 1px solid var(--charm-border-soft);
    border-radius: 2px;
  }

  .swap-btn {
    display: grid;
    place-items: center;
    min-width: 2.25rem;
    height: 2rem;
    padding-inline: 0.5rem;
    font-size: 1rem;
    line-height: 1;
    color: var(--charm-accent-text);
    background: transparent;
    border: 0;
    border-right: 1px solid var(--charm-border);
    cursor: pointer;
  }
  .swap-btn--wide {
    font-size: 0.8rem;
    font-weight: 700;
  }
  .swap-btn:hover {
    color: var(--charm-text);
    background: rgba(124, 58, 237, 0.2);
  }

  .swap-count {
    padding-inline: 0.75rem;
    color: var(--charm-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ── Swap view ────────────────────────────────────────────────────── */
  .swap-layout {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .swap-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: stretch;
    }
  }

  /* Stage first on mobile so the motion is visible above the fold. */
  .swap-stage {
    order: -1;
    position: relative;
    height: clamp(17rem, 62vw, 27rem);
    overflow: hidden;
    perspective: 900px;
  }

  @media (min-width: 900px) {
    .swap-stage {
      order: 0;
      height: auto;
      min-height: 27rem;
    }
  }

  .swap-panels {
    min-width: 0;
  }

  /* Card geometry. Translation/skew are applied by GSAP (xPercent -50). */
  .swap-card {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    flex-direction: column;
    width: min(25rem, 70%);
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: var(--charm-surface);
    border: 1px solid var(--charm-border-soft);
    border-radius: 6px;
    cursor: pointer;
    transform-style: preserve-3d;
    will-change: transform;
    backface-visibility: hidden;
  }

  .swap-card-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--charm-text);
    background: var(--charm-surface-strong);
    border-bottom: 1px solid var(--charm-border);
  }

  .swap-card-media {
    position: relative;
    flex: 1;
    min-height: 0;
    background: var(--charm-surface-strong);
  }
  .swap-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* Before JS positions the cards, keep them stacked & centred. */
  :global(html.js) .swap-card:not([style]) {
    transform: translate(-50%, -50%);
  }

  /* ── Grid view ────────────────────────────────────────────────────── */
  .project-card {
    transition: border-color 0.2s var(--ease-out);
  }
  .project-card:hover,
  .project-card:focus-within,
  .project-card:target {
    border-color: var(--charm-accent-soft);
  }

  .project-media {
    position: relative;
    aspect-ratio: 16 / 9;
    margin: 0.5rem 0.5rem 0;
    overflow: hidden;
    background: var(--charm-surface-strong);
    border: 1px solid var(--charm-border);
    border-radius: 3px;
  }

  /* Featured: media and body side by side on wide screens. */
  @media (min-width: 768px) {
    .project-card--featured {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      align-items: stretch;
    }
    .project-card--featured .project-media {
      aspect-ratio: auto;
      min-height: 20rem;
      margin: 0.5rem 0 0.5rem 0.5rem;
    }
  }

  .carousel,
  .carousel-img {
    position: absolute;
    inset: 0;
  }

  .carousel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
  }
  .carousel-img.is-active {
    opacity: 1;
  }

  /* Portrait (phone) screenshots: show the whole screen, letterboxed. */
  .carousel-img.is-contain,
  .swap-card-media img.is-contain {
    object-fit: contain;
    object-position: center;
    padding-block: 0.5rem;
  }

  /* Status-line style controls docked bottom-right. */
  .carousel-controls {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    z-index: 1;
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--charm-text);
    background: rgba(9, 9, 13, 0.9);
    border: 1px solid var(--charm-border-soft);
    border-radius: 2px;
  }

  .carousel-btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 1.75rem;
    font-size: 1rem;
    line-height: 1;
    color: var(--charm-accent-text);
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .carousel-btn:hover {
    color: var(--charm-text);
    background: rgba(124, 58, 237, 0.25);
  }

  .carousel-count {
    min-width: 2.5rem;
    padding-inline: 0.25rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
    border-inline: 1px solid var(--charm-border);
  }

  /* Shared by grid media and swap cards. */
  .project-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    padding: 1.25rem 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    /* Dot matrix hint so empty media still reads as "screen". */
    background-image: radial-gradient(var(--charm-border) 1px, transparent 1px);
    background-size: var(--cell-w) var(--cell-h);
  }

  .project-placeholder-name {
    font-size: clamp(1.1rem, 2vw + 0.5rem, 1.5rem);
    font-weight: 700;
    color: var(--charm-text);
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { CardSwap } from "../scripts/card-swap";

  type View = "swap" | "grid";
  const STORAGE_KEY = "projects-view";
  const root = document.documentElement;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const pad = (n: number) => String(n).padStart(2, "0");

  // ── Swap view ───────────────────────────────────────────────────────
  const stage = document.querySelector<HTMLElement>("[data-swap-stage]");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-swap-card]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-swap-panel]"));
  const current = document.querySelector<HTMLElement>("[data-swap-current]");
  const toggleBtn = document.querySelector<HTMLButtonElement>('[data-swap="toggle"]');
  const toggleIcon = document.querySelector<HTMLElement>("[data-swap-icon]");

  let swap: CardSwap | undefined;

  const showPanel = (index: number) => {
    panels.forEach((panel, i) => {
      const active = i === index;
      panel.hidden = !active;
      if (active && !reduced) {
        gsap.fromTo(panel, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.35, ease: "power2.out" });
      }
    });
    if (current) current.textContent = pad(index + 1);
  };

  /** Spacing scales with the rendered card so the stack fits any width. */
  const fitStack = () => {
    if (!swap || !cards[0]) return;
    const { offsetWidth: w, offsetHeight: h } = cards[0];
    if (w && h) swap.setDistances(Math.round(w * 0.11), Math.round(h * 0.13));
  };

  const panelsWrap = document.querySelector<HTMLElement>(".swap-panels");

  /** Announce panel changes only when the user is driving the stack. */
  const setLive = (manual: boolean) => panelsWrap?.setAttribute("aria-live", manual ? "polite" : "off");

  const updateToggle = () => {
    if (!toggleBtn || !toggleIcon) return;
    const stopped = reduced || toggleBtn.getAttribute("aria-pressed") === "true";
    toggleIcon.textContent = stopped ? "▶\uFE0E" : "||"; // FE0E: text (not emoji) glyph
    // Localized labels are rendered server-side as data attributes.
    const label = stopped ? toggleBtn.dataset.labelResume : toggleBtn.dataset.labelPause;
    if (label) toggleBtn.setAttribute("aria-label", label);
    setLive(stopped);
  };

  const manual = (action: () => void) => {
    setLive(true);
    action();
  };

  if (stage && cards.length) {
    swap = new CardSwap(stage, cards, {
      delay: 5000,
      pauseOnHover: true,
      skewAmount: 5,
      easing: "elastic",
      maxVisible: 4,
      // Respect reduced motion: no autoplay, the user steps manually.
      autoplay: !reduced,
      onFrontChange: showPanel,
    });

    fitStack();
    new ResizeObserver(fitStack).observe(stage);

    // Clicking the stack advances it, like the original onCardClick.
    stage.addEventListener("click", () => swap!.next());

    document.querySelector('[data-swap="next"]')?.addEventListener("click", () => manual(() => swap!.next()));
    document.querySelector('[data-swap="prev"]')?.addEventListener("click", () => manual(() => swap!.prev()));

    toggleBtn?.addEventListener("click", () => {
      if (reduced) {
        manual(() => swap!.next());
        return;
      }
      const pause = toggleBtn.getAttribute("aria-pressed") !== "true";
      toggleBtn.setAttribute("aria-pressed", String(pause));
      swap!.setPlaying(!pause);
      updateToggle();
    });

    // Keyboard focus inside the panel pauses rotation (WCAG 2.2.2).
    panelsWrap?.addEventListener("focusin", () => swap!.block("focus", true));
    panelsWrap?.addEventListener("focusout", () => swap!.block("focus", false));

    updateToggle();
  }

  // ── View switch ─────────────────────────────────────────────────────
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-view-tab]"));

  const setView = (view: View, persist = true) => {
    root.dataset.projectsView = view;
    tabs.forEach((tab) => {
      const selected = tab.dataset.viewTab === view;
      tab.setAttribute("aria-selected", String(selected));
      tab.tabIndex = selected ? 0 : -1;
    });
    swap?.block("view", view !== "swap");
    if (view === "swap") fitStack();
    if (persist) {
      try {
        localStorage.setItem(STORAGE_KEY, view);
      } catch {
        /* storage unavailable: preference just isn't remembered */
      }
    }
    // Hidden → visible changes layout; recompute scroll-reveal positions.
    ScrollTrigger.refresh();
  };

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => setView(tab.dataset.viewTab as View));
    // Arrow keys move between tabs (ARIA tabs pattern).
    tab.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      const next = tabs[(i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length];
      next.focus();
      setView(next.dataset.viewTab as View);
    });
  });

  setView(root.dataset.projectsView === "grid" ? "grid" : "swap", false);

  // Links like "#proyecto-rago" (from Logros) must work in either view.
  const ids = panels.map((p) => p.dataset.projectId);
  document.addEventListener("click", (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#proyecto-"]');
    if (!link || root.dataset.projectsView === "grid" || !swap) return;
    const index = ids.indexOf(link.hash.replace("#proyecto-", ""));
    if (index < 0) return;
    e.preventDefault();
    swap.goTo(index);
    document.getElementById("proyectos")?.scrollIntoView({ behavior: reduced ? "auto" : "smooth" });
  });

  // ── Grid carousels ──────────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLImageElement>("[data-slide]"));
    const counter = carousel.querySelector<HTMLElement>("[data-current]");
    if (slides.length < 2) return;
    let index = 0;

    const go = (dir: number) => {
      index = (index + dir + slides.length) % slides.length;
      slides.forEach((img, j) => {
        const active = j === index;
        img.classList.toggle("is-active", active);
        img.toggleAttribute("aria-hidden", !active);
      });
      if (counter) counter.textContent = String(index + 1);
    };

    carousel.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((btn) => {
      btn.addEventListener("click", () => go(Number(btn.dataset.dir)));
    });

    carousel.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") go(-1);
      else if (e.key === "ArrowRight") go(1);
    });
  });
</script>
