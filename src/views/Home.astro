---
/**
 * Home — the single-page portfolio. Rendered once per locale by
 * src/pages/index.astro (es) and src/pages/en/index.astro (en); the locale
 * comes from the URL via `Astro.currentLocale`.
 */
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Achievements from "../components/Achievements.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
---

<Layout>
  <main id="main" class="flex flex-col">
    <!-- ASCII art: animated "whoami" lives in Hero (src/scripts/ascii-text.ts) -->
    <Hero />
    <Experience />
    <Projects />
    <Achievements />
    <Skills />
    <Contact />
  </main>
</Layout>

<script>
  /**
   * Page-level motion (GSAP + ScrollTrigger):
   *   - Hero lines enter on load, in terminal order.
   *   - Section headers and cards fade + slide up as they scroll in.
   * Skills tag stagger lives in Skills.astro. Everything is skipped for
   * prefers-reduced-motion, leaving content fully visible.
   */
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.from(".hero-term", { y: 24, opacity: 0, duration: 0.7, ease: "power3.out" });
    gsap.from(".hero-term .hero-line, .hero-name, .hero-role, .hero-desc, .hero-actions", {
      y: 12,
      opacity: 0,
      duration: 0.5,
      ease: "power2.out",
      stagger: 0.08,
      delay: 0.25,
    });

    const reveal = (selector: string, y = 30) => {
      gsap.utils.toArray<HTMLElement>(selector).forEach((el) => {
        gsap.from(el, {
          y,
          opacity: 0,
          duration: 0.6,
          ease: "power3.out",
          scrollTrigger: { trigger: el, start: "top 88%", toggleActions: "play none none reverse" },
        });
      });
    };

    reveal(".section-header", 35);
    reveal(".exp-item");
    reveal(".project-card");
    reveal(".achievement-item");
    reveal(".contact-term", 20);
  }
</script>
